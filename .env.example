# Copy to .env for local dev, and set the same vars in your Vercel project.

# Neon Postgres. Use the POOLED connection string ("...-pooler...") here.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# Neon DIRECT (non-pooled) connection string — used only for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DB?sslmode=require"

# Clerk (https://dashboard.clerk.com — API Keys page of your application).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
# Where Clerk's components live in this app.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Needed to (re)seed the WaniKani subject content into the DB, and on Vercel
# for the weekly content-update cron (/api/cron/sync-content).
WANIKANI_API_KEY="your-wanikani-personal-access-token"

# Protects /api/cron/sync-content. Vercel Cron sends it automatically once set
# in the Vercel project env. Generate like AUTH_SECRET.
CRON_SECRET="change-me-to-a-long-random-string"
