generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (Neon "-pooler") for the app runtime
  directUrl = env("DIRECT_URL") // direct connection for migrations (falls back to DATABASE_URL locally)
}

model Subject {
  id             Int      @id // WaniKani subject id
  type           String // "radical" | "kanji" | "vocabulary" | "kana_vocabulary"
  level          Int
  characters     String? // null for image-only radicals
  characterImage String? // fallback image URL for image-only radicals
  mnemonicImage  String? // local path to mnemonic artwork (radicals), e.g. /radical-images/prison.png
  slug           String
  documentUrl    String
  // JSON-encoded arrays/objects (SQLite has no native JSON columns in Prisma)
  meanings       String // [{ meaning, primary, acceptedAnswer }]
  auxMeanings    String // [{ meaning, type: "whitelist"|"blacklist" }]
  readings       String // [{ reading, primary, acceptedAnswer, type? }]
  componentIds   String // [subjectId] — radicals for kanji, kanji for vocab
  amalgamationIds String // [subjectId] — reverse links ("found in")
  visuallySimilarIds String @default("[]") // [subjectId] — kanji that look alike
  meaningMnemonic String
  meaningHint    String?
  readingMnemonic String?
  readingHint    String?
  contextSentences String? // vocab: [{ en, ja }]
  partsOfSpeech  String? // vocab: [string]
  audioUrls      String? // vocab: [{ url, contentType }]
  lessonPosition Int      @default(0)

  assignments  Assignment[]
  reviewLogs   ReviewLog[]
  userSynonyms UserSynonym[]
  userNotes    UserNote[]

  @@index([level, type])
  // Subject-detail lookups resolve /kanji/<char> etc. by (type, characters),
  // and radicals by slug — without these every page view scans the table.
  @@index([type, characters])
  @@index([slug])
}

// Per-user free-form notes for a subject (WaniKani "Meaning Note" / "Reading
// Note"). One row per (user, subject); both fields are optional.
model UserNote {
  id           Int      @id @default(autoincrement())
  userId       String // "Tilbert" | "Kate" — see lib/users.ts
  subjectId    Int
  subject      Subject  @relation(fields: [subjectId], references: [id])
  meaningNote  String? // notes attached to the Meaning section
  readingNote  String? // notes attached to the Reading section
  updatedAt    DateTime @default(now()) @updatedAt

  @@unique([userId, subjectId])
  @@index([userId, subjectId])
}

// Per-user extra accepted meanings for a subject (WaniKani "User Synonyms").
// One row per (user, subject, synonym).
model UserSynonym {
  id        Int      @id @default(autoincrement())
  userId    String // "Tilbert" | "Kate" — see lib/users.ts
  subjectId Int
  subject   Subject  @relation(fields: [subjectId], references: [id])
  synonym   String
  createdAt DateTime @default(now())

  @@unique([userId, subjectId, synonym])
  @@index([userId, subjectId])
}

// Per-user SRS state for a subject. One row per (user, subject).
model Assignment {
  id          Int       @id @default(autoincrement())
  userId      String // "Tilbert" | "Kate" — see lib/users.ts
  subjectId   Int
  subject     Subject   @relation(fields: [subjectId], references: [id])
  srsStage    Int       @default(0) // 0 = lesson not taken, 1-4 Apprentice, 5-6 Guru, 7 Master, 8 Enlightened, 9 Burned
  unlockedAt  DateTime?
  startedAt   DateTime? // lesson completed
  availableAt DateTime? // next review due
  passedAt    DateTime? // first reached Guru
  burnedAt    DateTime?

  @@unique([userId, subjectId])
  @@index([availableAt])
  @@index([srsStage])
  @@index([userId])
  // The hot paths (due reviews, lesson queue, forecast) all filter on the
  // user plus one of these columns — same shape GrammarProgress/CustomVocab
  // already index.
  @@index([userId, availableAt])
  @@index([userId, startedAt])
}

model ReviewLog {
  id                    Int      @id @default(autoincrement())
  userId                String // "Tilbert" | "Kate" — see lib/users.ts
  subjectId             Int
  subject               Subject  @relation(fields: [subjectId], references: [id])
  createdAt             DateTime @default(now())
  startingStage         Int
  endingStage           Int
  meaningIncorrectCount Int      @default(0)
  readingIncorrectCount Int      @default(0)
  recallIncorrectCount  Int      @default(0) // English → reading (KaniWani-style) wrong attempts
  // Correct answers per dimension. In-app reviews record 1 per prompt asked;
  // rows imported from WaniKani review_statistics carry the between-sync delta
  // (which may span several reviews). Accuracy = correct / (correct + incorrect).
  meaningCorrectCount   Int      @default(0)
  readingCorrectCount   Int      @default(0)
  recallCorrectCount    Int      @default(0)

  @@index([createdAt])
  @@index([userId])
  // Recent-mistakes and accuracy queries filter (userId, createdAt) on this
  // append-only table — it grows fastest of all.
  @@index([userId, createdAt])
}

// Last-seen cumulative answer counts from WaniKani's review_statistics, one
// row per (user, subject). Each sync diffs fresh statistics against these to
// reconstruct the reviews done on WaniKani since the previous sync (the API
// no longer exposes individual review records), then updates them.
model ReviewStatSnapshot {
  id               Int      @id @default(autoincrement())
  userId           String
  subjectId        Int
  meaningCorrect   Int
  meaningIncorrect Int
  readingCorrect   Int
  readingIncorrect Int
  statUpdatedAt    DateTime // WaniKani's data_updated_at (= subject's last review time)

  @@unique([userId, subjectId])
  @@index([userId])
}

model UserProgress {
  userId         String   @id // "Tilbert" | "Kate" — see lib/users.ts
  currentLevel   Int      @default(1)
  // Last completed lesson batch or review — reads never touch this. Reviews
  // stop accumulating INACTIVITY_PAUSE_DAYS after it — see lib/progression.ts.
  lastActivityAt DateTime @default(now())
  // Per-user lesson pacing — see startLessons/startGrammarLessons in
  // lib/progression.ts. Configurable from /profile.
  dailyLessonLimit        Int @default(10)
  grammarDailyLessonLimit Int @default(2)
  // Mix radicals/kanji/vocab within each lesson batch instead of serving them
  // strictly in type order — see lib/lesson-order.ts. Mirrors WaniKani's
  // "Interleave Lessons" setting; on by default because a radical-heavy level
  // (level 4 ships 36) otherwise fills days of batches with radicals alone.
  interleaveLessons       Boolean @default(true)
}

// A user's own vocabulary (words/phrases not in WaniKani), each row carrying
// its own SRS state. This is a self-contained parallel system: it shares the
// stage model and intervals from lib/srs.ts but never touches Assignment,
// ReviewLog, or the unlock/level-up cascade.
model CustomVocab {
  id         Int      @id @default(autoincrement())
  userId     String
  // The word/phrase as written, e.g. "はじめまして". Null for a reading-only
  // item (no Japanese spelling given), which is then prompted by its reading.
  // Null rather than "" so the (userId, characters) unique index keeps ignoring
  // it — Postgres treats each NULL as distinct.
  characters String?
  meanings   String // JSON [string] — first entry is primary
  readings   String // JSON [string] — kana; empty only when characters is set
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  // SRS state — starts at Apprentice I the moment the item is added.
  srsStage    Int       @default(1)
  availableAt DateTime? // next review due; null once burned
  passedAt    DateTime? // first reached Guru
  burnedAt    DateTime?

  @@unique([userId, characters])
  @@index([userId, availableAt])
}

// Bunpro-style grammar SRS: a fixed N5→N1 catalog of grammar points, each
// studied via cloze (fill-in-the-blank) review of its example sentences. A
// parallel subsystem like CustomVocab — reuses lib/srs.ts's stage model and
// intervals but never touches Assignment/ReviewLog/Subject or the WaniKani
// unlock/level-up cascade. Unlike CustomVocab, the catalog is shared across
// users (seeded once from Bunpro), so it follows the Subject/Assignment split
// instead of an embedded single-table model.
model GrammarPoint {
  id             Int      @id @default(autoincrement())
  title          String
  jlptLevel      Int // 5 = N5 … 1 = N1
  position       Int // ordinal within its JLPT level
  sequence       Int // precomputed global ordinal N5→N1 for the fixed path
  lessonId       Int      @default(0) // Bunpro's global lesson id (1..50), 10 lessons per JLPT level
  lessonDescription String @default("") // Bunpro's lesson title, e.g. "Things that Are Crucial..."
  meaning        String
  structure      String // plain-text fallback (Bunpro's casual+polite structures, markup stripped and joined)
  // Bunpro sends two separate structure forms, each with inline color markup
  // (<strong> = red grammar term, <span class='chui'> = orange accent particle,
  // <del>/<sup>/<ruby> etc.). We store both raw so the UI can render the exact
  // colors and offer Bunpro's Standard/Polite toggle. structurePolite is ""
  // when Bunpro has no distinct polite form (most points). See lib/bunpro-scraper.ts.
  structureStandard String @default("") // raw HTML of Bunpro's casual_structure ("Standard")
  structurePolite   String @default("") // raw HTML of Bunpro's polite_structure ("Polite"); "" if none
  explanation    String // may hold light markup; sanitized to plain text at seed time
  partOfSpeech   String?
  register       String?
  wordType       String   @default("") // Bunpro's word_type_translation, e.g. "Dependent Word"
  caution        String   @default("") // Bunpro's short header warning, e.g. "だ cannot be used with い-Adjectives"
  aboutIntroBlocks String @default("[]") // JSON [{type:"text",text} | {type:"examples",examples:[{japanese,english,audioUrl}]}] — writeup body before the first caution subsection, in original prose/example order
  aboutCautions  String   @default("[]") // JSON [{text, examples: [{japanese, english, audioUrl}]}] — writeup caution subsections
  onlineResources  String @default("[]") // JSON [{site, description, link}] — Bunpro's "Online" reading links
  offlineResources String @default("[]") // JSON [{source, location}] — Bunpro's "Offline" textbook references
  slug           String   @unique

  sentences GrammarSentence[]
  progress  GrammarProgress[]
  reviewLogs GrammarReviewLog[]
  relations GrammarRelation[]

  @@index([sequence])
  @@index([jlptLevel, position])
}

// Bunpro's explainer modals behind the info dots on a grammar point page:
// Parts of Speech Legend, Word Type Legend, Register, Structure Legend, and
// the "All Technical Terms" glossary the first two link to. Site-wide static
// content (not per-point), scraped once from Bunpro's translation bundles by
// scripts/seed-grammar-legends.ts — stored in the DB like every other
// Bunpro-sourced text so none of it lives in the repo.
model GrammarLegend {
  key  String @id // "part-of-speech" | "word-type" | "register" | "structure" | "all-terms"
  data String // JSON GrammarLegendDTO minus key — see lib/grammar.ts
}

// Synonym/antonym/related links between grammar points, denormalized (title/
// meaning/slug of the "other" side stored directly, not FK'd) since Bunpro's
// relatedContents already gives us that data and the other point is always
// itself a seeded JLPT GrammarPoint by the time we filter+persist this.
model GrammarRelation {
  id               Int      @id @default(autoincrement())
  grammarPointId   Int
  grammarPoint     GrammarPoint @relation(fields: [grammarPointId], references: [id])
  relationshipType String // "synonym" | "antonym" | "related"
  body             String
  otherSlug        String
  otherTitle       String
  otherMeaning     String

  @@index([grammarPointId])
}

// Example sentences for a grammar point; reviews rotate through these via
// GrammarProgress.sentenceCursor. Always fetch ordered by position — rotation
// depends on a stable order.
model GrammarSentence {
  id              Int      @id @default(autoincrement())
  grammarPointId  Int
  grammarPoint    GrammarPoint @relation(fields: [grammarPointId], references: [id])
  bunproId        Int? // Bunpro's study_question id — lets aboutCautions/aboutIntroExampleIds cite a stable sentence
  japanese        String
  english         String
  acceptedAnswers String // JSON [string] — must include at least one kana-only variant (quiz input is kana-only)
  wrongAnswerHints String @default("{}") // JSON {wrongAnswer: hint} — meaning-equivalent misses shake with the hint instead of failing
  audioUrl        String? // R2
  position        Int

  @@unique([grammarPointId, position])
  @@index([grammarPointId])
}

// Per-user SRS state for a grammar point. Rows are created at lesson start
// (Apprentice I), so there is no separate unlockedAt — it would always equal
// startedAt.
model GrammarProgress {
  id             Int      @id @default(autoincrement())
  userId         String
  grammarPointId Int
  grammarPoint   GrammarPoint @relation(fields: [grammarPointId], references: [id])
  srsStage       Int       @default(0)
  startedAt      DateTime?
  availableAt    DateTime?
  passedAt       DateTime?
  burnedAt       DateTime?
  sentenceCursor Int       @default(0) // rotates which example sentence is shown next

  @@unique([userId, grammarPointId])
  @@index([userId, availableAt])
  @@index([availableAt])
}

model GrammarReviewLog {
  id             Int      @id @default(autoincrement())
  userId         String
  grammarPointId Int
  grammarPoint   GrammarPoint @relation(fields: [grammarPointId], references: [id])
  createdAt      DateTime @default(now())
  startingStage  Int
  endingStage    Int
  incorrectCount Int      @default(0) // binary: 1 if there was any miss before the correct retype, else 0
  correctCount   Int      @default(0)

  @@index([createdAt])
  @@index([userId])
  @@index([userId, createdAt])
}
